# Autodesk Platform Services (APS) app credentials - from aps.autodesk.com app page
APS_CLIENT_ID=
APS_CLIENT_SECRET=
# Must exactly match the Callback URL registered on the APS app:
APS_CALLBACK_URL=https://YOUR-RENDER-URL.onrender.com/auth/callback
# 3-legged scopes (read-only for the demo)
APS_SCOPES=data:read

# BuildingConnected mode: "test" = free sample-data environment (GET only), "live" = real tenant data
BC_MODE=test

# Port (Render sets this automatically)
PORT=3000
